render_api_key    = "REPLACE_ME"
render_owner_id   = "REPLACE_ME"
repo_url          = "https://github.com/your-org/your-repo"
branch            = "main"
root_dir          = ""
runtime           = "docker"
plan              = "free"
region            = "oregon"
service_name      = "google-calendar-service"

google_calendar_client_id        = "your-client-id.apps.googleusercontent.com"
google_calendar_client_secret    = "REPLACE_ME"
google_calendar_refresh_token    = "REPLACE_ME"
google_calendar_redirect_uri     = "https://your-service.onrender.com/auth/callback"
google_calendar_session_secret   = "REPLACE_ME"
calendar_cookie_value            = "REPLACE_ME"
calendar_service_base_url        = "https://your-service.onrender.com"

google_calendar_token_uri                    = "https://oauth2.googleapis.com/token"
google_calendar_scopes                       = "https://www.googleapis.com/auth/calendar"
google_calendar_oauth_auth_url               = "https://accounts.google.com/o/oauth2/v2/auth"
google_calendar_oauth_token_url              = "https://oauth2.googleapis.com/token"
google_calendar_oauth_allowed_token_hosts    = "oauth2.googleapis.com"
google_calendar_oauth_prompt                 = "consent"
google_calendar_oauth_state_ttl_seconds      = "600"
google_calendar_oauth_token_timeout_seconds  = "10"

google_calendar_session_cookie_name       = "google_calendar_session_id"
google_calendar_session_identifier        = "google_calendar_service_verifier"
google_calendar_session_cookie_secure     = "true"

calendar_cookie_id     = "google_calendar_session_id"
default_calendar_id    = "primary"
health_check_path      = "/health"
docker_command         = ""

openai_api_key = "REPLACE_ME"

trello_api_key   = "REPLACE_ME"
trello_api_token = "REPLACE_ME"
trello_board_id  = "REPLACE_ME"

otel_service_name           = "google-calendar-service"
otel_exporter_otlp_endpoint = "https://otlp-gateway-prod-<region>.grafana.net/otlp"
otel_exporter_otlp_protocol = "http/protobuf"
otel_resource_attributes    = "service.namespace=ospsd-team-11"
otel_exporter_otlp_headers  = "Authorization=Basic%20<your-base64-token>"
